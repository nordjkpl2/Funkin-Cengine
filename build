>Clang
    Com Fito
clang -std=c23 -Os -flto=thin -fuse-ld=lld -ffunction-sections -fdata-sections -fmerge-all-constants -funroll-loops -fomit-frame-pointer -fno-math-errno -fno-common -DNDEBUG -DPLATFORM_DESKTOP -DGRAPHICS_API_OPENGL_33 -mwindows main.c $(find src -type f -name "*.c") $(find lib -maxdepth 1 -type f -name "*.c") lib/raylib55/src/raudio.c lib/raylib55/src/rcore.c lib/raylib55/src/rmodels.c lib/raylib55/src/rshapes.c lib/raylib55/src/rtext.c lib/raylib55/src/rtextures.c lib/raylib55/src/utils.c lib/raylib55/src/rglfw.c -o FNF_C_ENGINE.exe -I./headers -I./src -I./lib -I./lib/raylib55/src -I./lib/raylib55/src/external/glfw/include -lopengl32 -lgdi32 -lwinmm -luser32 -lshell32 -Wl,--gc-sections,--icf=all,-O12

clang -std=c23 -Os -flto=thin -fuse-ld=lld -ffunction-sections -fdata-sections -fmerge-all-constants -funroll-loops -fomit-frame-pointer -fno-math-errno -fno-common -DNDEBUG -mwindows -DPLATFORM_DESKTOP_GLFW -DGRAPHICS_API_OPENGL_33 main.c $(find src -type f -name "*.c") $(find lib -type f -name "*.c" ! -path "lib/raylib55/*") $(find lib/raylib55/src -maxdepth 1 -type f -name "*.c") -o FNF_C_ENGINE.exe -I./headers -I./src -I./lib -I./lib/raylib55/src -I./lib/raylib55/src/external/glfw/include -lopengl32 -lgdi32 -lwinmm -luser32 -lshell32 -Wl,--gc-sections,--icf=all,-O12
// por -fno-plt pra ELF64

